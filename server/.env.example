PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hmwssb

# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=8h

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HMWSSB Works Management <your-email@gmail.com>

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Seed password for initial admin/manager/dgm/gm/viewer users
SEED_ADMIN_PASSWORD=Admin@123456

# OTP HMAC secret (auto-generated if not set)
OTP_HMAC_SECRET=

# PKI / Digital Signing
PKI_KEYS_DIR=keys
HSM_ENDPOINT=
HSM_KEY_ID=

# P12 Signing Certificate Password (REQUIRED for PDF signing)
P12_SIGNING_PASSWORD=

# RFC 3161 Timestamp Authority
TSA_URL=https://timestamp.digicert.com

# PDF Signature placeholder size
SIGNATURE_PLACEHOLDER_LENGTH=8192

# Redis (optional, falls back to in-memory)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# Logging
LOG_LEVEL=info
