# HMWSSB Digital Signature - Docker Compose Environment
# Copy this file to .env and fill in the values

# JWT Secret (minimum 32 characters)
JWT_SECRET=change-this-to-a-strong-secret-at-least-32-chars-long

# Seed admin password
SEED_ADMIN_PASSWORD=Admin@123456

# SMTP Configuration (for OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=HMWSSB Works Management <your-email@gmail.com>

# Twilio SMS Configuration (for OTP SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Redis (optional, falls back to in-memory)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# Logging
LOG_LEVEL=info
