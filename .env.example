# HMWSSB Works Management - TEST SERVER deployment environment
# Copy this file to .env and fill in the values. Do NOT commit .env.
# NOTE: Point DATABASE_URL / POSTGRES_* at a SEPARATE TEST database, never production.

# ── PostgreSQL (TEST database / db container) ──────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hmwssb_test
# Connection string used by the backend / migrations (docker: host "db")
DATABASE_URL=postgresql://postgres:postgres@db:5432/hmwssb_test
# Outside docker the host is the DB server, e.g.
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hmwssb_test

# ── Backend ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5001

# JWT signing secret (minimum 32 characters)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-secret-at-least-32-chars-long
JWT_EXPIRES_IN=8h

# Comma-separated origins allowed to call the API (the TEST frontend URL).
# Same-origin deployments behind the nginx proxy may keep just the site origin.
CORS_ORIGINS=http://localhost,http://localhost:5173

# ── SMTP / OTP email delivery ──────────────────────────────────────────────────
# Gmail: create an App Password (requires 2-Step Verification) and set SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM=HMWSSB Works Management System <you@gmail.com>
# Dev/test OTPs are sent to this address instead of real users' emails.
MAIL_DEV_RECIPIENT=you@gmail.com
OTP_RESEND_COOLDOWN=30

# ── Seed (one-time) ────────────────────────────────────────────────────────────
SEED_ADMIN_PASSWORD=password123

# ── Frontend (build-time, only for a non-proxied deployment) ───────────────────
# Leave empty to use the same-origin '/api' path (nginx proxy in docker).
# For a frontend NOT behind the nginx proxy, set the full TEST backend URL, e.g.
#   VITE_API_URL=https://api-test.example.com
VITE_API_URL=
# Vite dev-server proxy target (used only by `npm run dev`).
VITE_API_TARGET=http://localhost:5001