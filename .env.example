# HMWSSB Works Management - Docker Compose environment
# Copy this file to .env and fill in the values

# JWT signing secret (minimum 32 characters)
JWT_SECRET=change-this-to-a-strong-secret-at-least-32-chars-long

# PostgreSQL connection (server container)
DATABASE_URL=postgresql://postgres:postgres@db:5432/hmwssb

# PostgreSQL credentials (db container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hmwssb

# Seed admin password
SEED_ADMIN_PASSWORD=password123
